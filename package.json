{
  "name": "@farfarfun/utools-funtime",
  "funbuild": {
    "build": "sh build.sh"
  },
  "version": "0.1.0",
  "description": "分秒必争 FunTime：离线精密计时与世界时钟工作台，支持多任务倒计时、番茄专注钟、毫秒级秒表记次、28 城世界时钟与跨时区会议滑块、桌面置顶悬浮小窗与日期时间推算",
  "license": "MIT",
  "homepage": "https://farfarfun.github.io/packages/utools-funtime/",
  "repository": {
    "type": "git",
    "url": "https://github.com/farfarfun-utools/utools-funtime.git"
  },
  "bugs": {
    "url": "https://github.com/farfarfun-utools/utools-funtime/issues"
  },
  "keywords": [
    "utools",
    "utools-plugin",
    "funtime",
    "timer",
    "countdown",
    "pomodoro",
    "stopwatch",
    "world-clock",
    "timezone",
    "floating-widget",
    "vue3",
    "typescript",
    "farfarfun"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "screenshots": "pnpm build && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.12"
  }
}
